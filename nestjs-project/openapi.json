          "409": {
            "description": "UPLOAD_NOT_IN_PROGRESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Cancel an upload",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "awaiting_upload",
              "processing",
              "ready",
              "failed"
            ],
            "example": "awaiting_upload"
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          },
          "partSize": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "id",
          "publicId",
          "title",
          "processingStatus",
          "publicationStatus",
          "partSize",
          "partCount"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "originalFilename": {
            "type": "string",
            "example": "aula.mp4"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "sizeBytes": {
            "type": "number",
            "example": 15728640
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "awaiting_upload",
              "processing",
              "ready",
              "failed"
            ]
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "processingError": {
            "type": "string",
            "nullable": true,
            "example": "MEDIA_INVALID: no video stream"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "example": 2.04
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "formatName": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitrate": {
            "type": "number",
            "nullable": true,
            "example": 5000000
          },
          "frameRate": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          },
          "streamUrl": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET of the original (supports Range/206); only when ready"
          },
          "downloadUrl": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET forcing Content-Disposition: attachment; only when ready"
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET of the thumbnail; only when ready"
          },
          "urlsExpireAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "publicId",
          "title",
          "originalFilename",
          "contentType",
          "sizeBytes",
          "processingStatus",
          "publicationStatus",
          "processingError",
          "processedAt",
          "durationSeconds",
          "width",
          "height",
          "videoCodec",
          "audioCodec",
          "formatName",
          "bitrate",
          "frameRate",
          "streamUrl",
          "downloadUrl",
          "thumbnailUrl",
          "urlsExpireAt",
          "createdAt"
        ]
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL (PUT the bytes here)"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "sizeBytes": {
            "type": "number",
            "example": 67108864
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          }
        },
        "required": [
          "partNumber",
          "sizeBytes",
          "etag"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "VideoCompleteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publicId": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "awaiting_upload",
              "processing",
              "ready",
              "failed"
            ],
            "example": "processing"
          }
        },
        "required": [
          "id",
          "publicId",
          "processingStatus"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}