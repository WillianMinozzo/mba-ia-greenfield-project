          "videos"
        ]
      }
    },
    "/videos/{publicId}": {
      "get": {
        "description": "Returns the owner view of the video. streamUrl, downloadUrl and thumbnailUrl are presigned storage URLs, present only when processingStatus is ready.",
        "operationId": "VideosController_findOne",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get video details",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload/part-urls": {
      "get": {
        "description": "Returns presigned UploadPart URLs; the client PUTs each part directly to storage.",
        "operationId": "VideosController_signPartUrls",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partNumbers",
            "required": true,
            "in": "query",
            "description": "Comma-separated distinct part numbers (1 to 100 items)",
            "schema": {
              "example": "1,2,3",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartUrlsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid partNumbers (VALIDATION_ERROR or INVALID_PART_NUMBER)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "UPLOAD_NOT_IN_PROGRESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign upload part URLs",
        "tags": [
          "videos"
        ]
      }
    },
